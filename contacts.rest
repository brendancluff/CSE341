@baseUrl = http://localhost:8080
@productionUrl = https://cse341-5xjq.onrender.com
@contactId = REPLACE_WITH_REAL_ID

### Local - Get all contacts
GET {{baseUrl}}/contacts

### Production - Get all contacts
GET {{productionUrl}}/contacts

### Local - Get one contact
GET {{baseUrl}}/contacts/{{contactId}}

### Production - Get one contact
GET {{productionUrl}}/contacts/{{contactId}}

### Local - Create a contact
POST {{baseUrl}}/contacts
Content-Type: application/json

{
  "firstName": "Video",
  "lastName": "Demo",
  "email": "video.demo@example.com",
  "favoriteColor": "Blue",
  "birthday": "1995-01-01"
}

### Production - Create a contact
POST {{productionUrl}}/contacts
Content-Type: application/json

{
  "firstName": "Video",
  "lastName": "Demo",
  "email": "video.demo@example.com",
  "favoriteColor": "Blue",
  "birthday": "1995-01-01"
}

### Local - Update a contact
PUT {{baseUrl}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Video",
  "lastName": "Updated",
  "email": "video.updated@example.com",
  "favoriteColor": "Green",
  "birthday": "1995-01-01"
}

### Production - Update a contact
PUT {{productionUrl}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Video",
  "lastName": "Updated",
  "email": "video.updated@example.com",
  "favoriteColor": "Green",
  "birthday": "1995-01-01"
